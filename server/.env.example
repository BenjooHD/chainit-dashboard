# Lokal: einfach zu server/.env kopieren.
# In Railway/Render: als Environment Variables im Projekt-Dashboard eintragen.

# Zufälliger, geheimer String zum Signieren der Session-Cookies.
# Generieren z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port, auf dem der Server lauscht. Railway/Render setzen diesen automatisch.
PORT=3001

# Nur fuer lokale Entwicklung noetig (Vite laeuft auf einem anderen Port als die API).
# In Produktion (ein Server liefert Frontend + API aus) leer lassen / weglassen.
CLIENT_ORIGIN=http://localhost:5173

# Absoluter Pfad zur SQLite-Datenbankdatei. In Produktion auf den Mount-Pfad
# des persistenten Volumes zeigen lassen, z.B. /data/chainit.db.
# Lokal kann diese Variable weggelassen werden (nutzt dann server/data/chainit.db).
DB_PATH=
