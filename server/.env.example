# Lokal: einfach zu server/.env kopieren.
# In Railway/Render: als Environment Variables im Projekt-Dashboard eintragen.

# Zufälliger, geheimer String zum Signieren der Session-Cookies.
# Generieren z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port, auf dem der Server lauscht. Railway/Render setzen diesen automatisch.
PORT=3001

# Nur fuer lokale Entwicklung noetig (Vite laeuft auf einem anderen Port als die API).
# In Produktion (ein Server liefert Frontend + API aus) leer lassen / weglassen.
CLIENT_ORIGIN=http://localhost:5173

# Absoluter Pfad zur SQLite-Datenbankdatei. In Produktion auf den Mount-Pfad
# des persistenten Volumes zeigen lassen, z.B. /data/chainit.db.
# Lokal kann diese Variable weggelassen werden (nutzt dann server/data/chainit.db).
DB_PATH=

# URL des Frontends – wird fuer den Link in der Verifizierungs-Mail gebraucht.
# Lokal: http://localhost:5173 (Vite-Dev-Server).
# In Produktion: die tatsaechliche Domain/URL der App (ein Server liefert beides aus).
APP_URL=http://localhost:5173

# API-Key von https://resend.com (Dashboard -> API Keys -> Create API Key).
# Ohne Key wird der Verifizierungs-Link nur in die Server-Konsole geloggt (fuer lokales Testen ok).
RESEND_API_KEY=

# Absenderadresse fuer Verifizierungs-Mails.
# Ohne eigene verifizierte Domain in Resend: onboarding@resend.dev (kann aber nur an die
# E-Mail-Adresse deines Resend-Accounts senden). Fuer echten Team-Betrieb: eigene Domain in
# Resend verifizieren und hier z.B. "ChainIt <noreply@deine-domain.de>" eintragen.
RESEND_FROM_EMAIL=ChainIt <onboarding@resend.dev>

# IMAP-Zugang zum gemeinsamen Firmenpostfach (fuer den Mail-Bereich).
# Ohne diese beiden Variablen zeigt der Mail-Bereich nur einen Hinweis, dass
# nichts konfiguriert ist -- der Rest der App laeuft trotzdem normal weiter.
IMAP_HOST=imap.ionos.de
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
